<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroAlloc.ORM.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- #283 fixed every warning this project produced except one: 8 EPS06 warnings
         (ErrorProne.NET.Structs, "hidden copy of a non-readonly struct") coming entirely
         from Dapper.AOT's own generated interceptor code — the flagged file is regenerated
         on every build from our Dapper call sites, and the struct causing the copy
         (Dapper.UnifiedCommand) lives inside the Dapper.AOT package itself, not in this repo.
         Dapper.AOT 1.1.0 (referenced below) is already the latest release, so there is no
         upgrade path today, and dropping Dapper.AOT would remove one of the three baselines
         this project benchmarks against. No project-side fix exists that isn't a suppression
         (NoWarn / pragma / SuppressMessage / editorconfig severity downgrade), all of which are
         disallowed by repo policy. Tracked in #287; flip this to true once that closes. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Server GC + concurrent GC make BDN numbers more representative of
         production workloads (matching ZA.Rest's BDN setup). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- BDN only produces meaningful numbers in Release config. Surface a warning
       (not an error) when invoked in Debug so a stray `dotnet run` still builds
       but the user is told the numbers will be misleading. -->
  <Target Name="WarnOnNonReleaseConfig" BeforeTargets="Build" Condition="'$(Configuration)' != 'Release'">
    <Warning Text="BenchmarkDotNet requires -c Release. Build will succeed but benchmark results will be misleading." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.ORM\ZeroAlloc.ORM.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.ORM.Abstractions\ZeroAlloc.ORM.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.ORM.Generator\ZeroAlloc.ORM.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: override the vulnerable native SQLite
         binary (SQLitePCLRaw.lib.e_sqlite3 2.1.11, SQLite < 3.50.2) pulled in
         transitively by Microsoft.Data.Sqlite. 3.50.3 ships SQLite 3.50.3. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <!-- Dapper.AOT generates interceptors that replace standard Dapper call
         sites at build time. The interceptors-preview namespace below opts in
         to the C# preview feature the generator uses to rewrite Dapper calls.
         Dapper itself supplies the QueryFirstOrDefaultAsync<T>() extension. -->
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Dapper.AOT" Version="1.1.0" />
    <!-- Postgres backend variant (Phase A.4). Gated at runtime via the
         "Postgres" benchmark category - the default `dotnet run` invocation
         only triggers Sqlite workloads. Run Postgres locally with
         `dotnet run -c Release [args] *Postgres*` (Docker required). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <PropertyGroup>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
  </PropertyGroup>
</Project>
