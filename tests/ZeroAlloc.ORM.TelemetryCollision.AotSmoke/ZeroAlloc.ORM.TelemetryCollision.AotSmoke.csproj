<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroAlloc.ORM.TelemetryCollision.AotSmoke</RootNamespace>
    <AssemblyName>ZeroAlloc.ORM.TelemetryCollision.AotSmoke</AssemblyName>
    <IsPackable>false</IsPackable>

    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- ZA.ORM emits raw ADO.NET and ZA.Telemetry emits a closed proxy class, so
         the composition should produce no IL2026/IL3050. Treating them as errors
         is the point of the gate: a trimmer regression in either generator must
         fail the build rather than degrade silently at runtime. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2067;IL2075;IL2091;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- ZA.ORM: project references (local dev, NOT NuGet) so the gate tests the
         working tree rather than the last published package. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.ORM\ZeroAlloc.ORM.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.ORM.Generator\ZeroAlloc.ORM.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ZA.Telemetry: latest published 1.4.x from NuGet. The main package bundles
         the source generator as an analyzer, so a single PackageReference covers
         it. 1.4.1 is the floor — it carries the nullable-annotation fix
         (ZeroAlloc.Telemetry#29) that this smoke exists to keep honest. -->
    <PackageReference Include="ZeroAlloc.Telemetry" Version="1.6.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: override the vulnerable native SQLite
         binary (SQLitePCLRaw.lib.e_sqlite3 2.1.11, SQLite < 3.50.2) pulled in
         transitively by Microsoft.Data.Sqlite. 3.50.3 ships SQLite 3.50.3. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>
</Project>
