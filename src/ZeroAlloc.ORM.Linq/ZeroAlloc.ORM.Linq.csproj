<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroAlloc.ORM.Linq</RootNamespace>
    <PackageId>ZeroAlloc.ORM.Linq</PackageId>
    <Title>ZeroAlloc.ORM.Linq</Title>
    <Description>Compile-time LINQ authoring surface for ZeroAlloc.ORM: the [LinqQuery] companion pattern with Sql.Table, QueryOperators and SqlRow. The chain is read by the ZeroAlloc.ORM generator at build time and emitted as SQL; the methods never run.</Description>
    <PackageTags>zeroalloc;orm;linq;ado.net;source-generator;nativeaot;trimming</PackageTags>
    <!-- Authoring surface only: every member throws, the generator reads the calls at build time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.ORM.Abstractions\ZeroAlloc.ORM.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
